#version 450

// Chroma bi-shrink, pointwise branch (levels below BiShrinkAB's top level): unblurred, squared shrink factor,
// ab *= SQR(1 - exp(-SQR(ab)/(noisevarchrom*mad_abr) - SQR(L)/(9*mad_Lr))). Inputs match dn_shrink_ab_sf.comp.

layout(local_size_x_id = 0) in;
layout(constant_id = 0) const uint LX = 256;

layout(std430, set = 0, binding = 0) buffer Ab { float v[]; } ab;
layout(std430, set = 0, binding = 1) readonly buffer L { float v[]; } lum;
layout(std430, set = 0, binding = 2) readonly buffer Nv { float v[]; } nv;
layout(std430, set = 0, binding = 3) readonly buffer MadAb { float v[]; } madab;
layout(std430, set = 0, binding = 4) readonly buffer MadL { float v[]; } madl;

layout(push_constant) uniform PC {
    uint n;
    uint levels;
    uint madBase;
    float madabScale;
} pc;

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.n * pc.levels) {
        return;
    }
    uint lvl = gid / pc.n;
    uint i = gid - lvl * pc.n;

    float ma = madab.v[pc.madBase + lvl];
    ma = (ma * ma) * pc.madabScale;
    float ml = madl.v[pc.madBase + lvl];
    ml = ml * ml;

    float c = ab.v[gid];
    float mag_ab = c * c;
    float l = lum.v[gid];
    float mag_L = (l * l) * (1.0 / (ml * 9.0));

    float sf = 1.0 - exp(-(mag_ab / (nv.v[i] * ma)) - mag_L);
    ab.v[gid] = c * (sf * sf);
}
