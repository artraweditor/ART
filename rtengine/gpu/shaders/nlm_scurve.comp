#version 450
#extension GL_GOOGLE_include_directive : require

// detail_mask's final S-curve remap (nlmeans.cc:383-397): mask = xlin2log(pow(clamp01(mask+thr),2.23),101), thr = 1-factor.

#include "include/art_color.glsl"

layout(local_size_x_id = 0, local_size_y_id = 1) in;
layout(constant_id = 0) const uint LX = 16;
layout(constant_id = 1) const uint LY = 16;

layout(std430, set = 0, binding = 0) buffer Buf { float v[]; } buf;

layout(push_constant) uniform PC {
    uint w;
    uint h;
    float thr;
} pc;

void main()
{
    uvec2 g = gl_GlobalInvocationID.xy;
    if (g.x >= pc.w || g.y >= pc.h) {
        return;
    }
    uint o = g.y * pc.w + g.x;
    float x = clamp(buf.v[o] + pc.thr, 0.0, 1.0);
    buf.v[o] = art_xlin2log(pow(x, 2.23), 101.0);
}
