#version 450
#extension GL_GOOGLE_include_directive : require

// Denoise phase 7: totwt plane, totwt[i][j] += tilemask_in[i][j]*tilemask_out[i][j] per covering block (ipdenoise.cc:3332).

layout(local_size_x_id = 0, local_size_y_id = 1) in;
layout(constant_id = 0) const uint LX = 16;
layout(constant_id = 1) const uint LY = 8;

// Separate bindings, not halves of one buffer: see driver hazard note in include/dn_dct.glsl.
layout(std430, set = 0, binding = 0) readonly buffer Fv { float v[]; } fv;
layout(std430, set = 0, binding = 1) readonly buffer Gv { float v[]; } gv;
layout(std430, set = 0, binding = 2) writeonly buffer Out { float v[]; } totwt;

layout(push_constant) uniform PC {
    uint w;
    uint h;
    // ceil(w/offset)+2*blkrad, the *fill* loop's count (larger than the gather's nbW_out). Intentional CPU
    // quirk reproduced here: the extra strip carries weight from a block that contributes no detail.
    uint nbW;
    uint nbH;
    float eps;
} pc;

#include "include/dn_dct.glsl"

void main()
{
    const uvec2 g = gl_GlobalInvocationID.xy;
    if (g.x >= pc.w || g.y >= pc.h) {
        return;
    }
    const int x = int(g.x), y = int(g.y);
    const int vlast = DN_DCT_LAST_BLK(y);
    const int hlast = DN_DCT_LAST_BLK(x);

    float s = 0.0;
    for (int ph = 0; ph < DN_DCT_PHASES; ++ph) {
        const int vblk = DN_DCT_BLK_IN_PHASE(vlast, ph);
        if (vblk >= 0 && vblk < int(pc.nbH)) {
            const int i = y - (vblk - BLKRAD) * OFFSET;
            if (i >= 0 && i < TS) {
                for (int hblk = hlast - (DN_DCT_PHASES - 1); hblk <= hlast;
                     ++hblk) {
                    if (hblk >= 0 && hblk < int(pc.nbW)) {
                        const int j = x - (hblk - BLKRAD) * OFFSET;
                        if (j >= 0 && j < TS) {
                            const float tin = fv.v[i] * fv.v[j] + pc.eps;
                            const float tout = gv.v[i] * gv.v[j] + pc.eps;
                            s += tin * tout;
                        }
                    }
                }
            }
        }
    }
    totwt.v[uint(y) * pc.w + uint(x)] = s;
}
