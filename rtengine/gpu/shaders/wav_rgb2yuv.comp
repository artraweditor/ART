#version 450

// RGB to YUV, in place, for wavelet smoothing's Channel::L/C setup (Color::rgb2yuv row-1 formula).

layout(local_size_x_id = 0, local_size_y_id = 1) in;
layout(constant_id = 0) const uint LX = 16;
layout(constant_id = 1) const uint LY = 16;

layout(std430, set = 0, binding = 0) buffer R { float v[]; } rC;
layout(std430, set = 0, binding = 1) buffer G { float v[]; } gC;
layout(std430, set = 0, binding = 2) buffer B { float v[]; } bC;

layout(push_constant) uniform PC {
    uint w;
    uint h;
    float ws1x;
    float ws1y;
    float ws1z;
} pc;

void main()
{
    uvec2 g = gl_GlobalInvocationID.xy;
    if (g.x >= pc.w || g.y >= pc.h) {
        return;
    }
    uint o = g.y * pc.w + g.x;
    float r = rC.v[o], gg = gC.v[o], b = bC.v[o];
    float y = r * pc.ws1x + gg * pc.ws1y + b * pc.ws1z;
    float u = y - b;
    float v = r - y;
    gC.v[o] = y;
    rC.v[o] = u;
    bC.v[o] = v;
}
