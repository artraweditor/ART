#version 450

// Wavelet FIR analysis, horizontal half (cplx_wavelet_level.h AnalysisFilterSubsampHorizontal, level 0).
// No extra scale factor here, unlike the vertical pass -- matches the CPU.

layout(local_size_x_id = 0, local_size_y_id = 1) in;
layout(constant_id = 0) const uint LX = 16;
layout(constant_id = 1) const uint LY = 16;

layout(std430, set = 0, binding = 0) readonly buffer Src { float v[]; } src;
layout(std430, set = 0, binding = 1) writeonly buffer Lo { float v[]; } lo;
layout(std430, set = 0, binding = 2) writeonly buffer Hi { float v[]; } hi;

layout(push_constant) uniform PC {
    uint w;
    uint h2;
    uint w2;
    int skip;
    int offset;
    float filterLo[6];
    float filterHi[6];
} pc;

void main()
{
    uvec2 g = gl_GlobalInvocationID.xy;
    if (g.x >= pc.w2 || g.y >= pc.h2) {
        return;
    }
    int col = int(g.x) * 2;
    float accLo = 0.0, accHi = 0.0;
    for (int j = 0; j < 6; ++j) {
        int l = pc.skip * (pc.offset - j);
        int cx = clamp(col + l, 0, int(pc.w) - 1);
        float s = src.v[g.y * pc.w + uint(cx)];
        accLo += pc.filterLo[j] * s;
        accHi += pc.filterHi[j] * s;
    }
    uint o = g.y * pc.w2 + g.x;
    lo.v[o] = accLo;
    hi.v[o] = accHi;
}
